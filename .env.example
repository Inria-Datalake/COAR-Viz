# Environment configuration
# Copy to .env and adjust for your setup:  cp .env.example .env
# Real environment variables (e.g. those injected by Docker) take precedence over .env.
# Under Docker, ARANGO_HOST is typically the service name (e.g. "arangodb"); for local
# runs use localhost.

# --- ArangoDB (required; HOST/PORT have no defaults) ---
ARANGO_HOST=localhost
ARANGO_PORT=8529
ARANGO_LOGIN=root
ARANGO_PASSWORD=changeme

# The database name is fixed in code (SOF-viz-COAR) and created automatically on first launch.

# --- Elasticsearch (required for ingestion and search/autocomplete) ---
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
